{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gravity Is a Liar",
  "version": "1.0.0",
  "identifier": "com.firuzdesign.gravityisaliar",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "Gravity Is a Liar", "width": 1280, "height": 720, "minWidth": 640, "minHeight": 360, "resizable": true, "center": true }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "shortDescription": "Gravity flips when you blink",
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "installMode": "currentUser" }
    }
  }
}
